{
  "manifest_version": 3,
  "name": "Start",
  "version": "1.1.0",
  "description": "A personal new tab: today's poster, a daily quote, your apps and a Spotify remote that floats on every page.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["bookmarks", "storage", "unlimitedStorage", "identity", "favicon", "search"],
  "host_permissions": [
    "https://*.scdn.co/*", "https://*.spotifycdn.com/*",
    "https://api.unsplash.com/*", "https://images.unsplash.com/*",
    "https://zenquotes.io/*"
  ],
  "background": { "service_worker": "js/background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://open.spotify.com/*"],
      "js": ["js/float.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Show or hide the floating Spotify player in this window" },
  "commands": {
    "toggle-float": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Show or hide the floating Spotify player in this window"
    }
  },
  "icons": { "128": "icons/icon128.png" }
}
